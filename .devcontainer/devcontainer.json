{
  "name": "Rust TAOCP",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
     "--env-file",
     "${localWorkspaceFolder}/.env-secrets"
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "rust-analyzer.check.command": "clippy",
        "rust-analyzer.cargo.features": "all",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "rust-lang.rust-analyzer"
      },
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "tamasfe.even-better-toml",
        "google.geminicodeassist",
        "openai.chatgpt",
        "anthropic.claude-code",
        "google.gemini-cli-vscode-ide-companion"
      ]
    }
  },

  "postCreateCommand": "rustc --version && cargo --version && mkdir -p ~/.codex && echo 'sandbox_mode = \"danger-full-access\"' > ~/.codex/config.toml && printf '{\"hasCompletedOnboarding\":true,\"installMethod\":\"npm\",\"autoUpdates\":false}' > ~/.claude.json",

  "remoteUser": "vscode",

  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  }
}
